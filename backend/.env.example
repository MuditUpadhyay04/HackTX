# Copy to backend/.env for local runs. On Render, set these in the dashboard.
# Every key is optional: without MODEL_API_KEY the app runs on clearly labeled mock AI,
# and without the WhatsApp keys Mom's 8 AM falls back to a "send it now?" nudge.

# --- Meta Model API (Muse Spark + Muse Voice Transcribe) ---
MODEL_API_KEY=
SPARK_MODEL=muse-spark-1.3
ASR_MODEL=muse-voice-transcribe-1.0

# --- WhatsApp Cloud API (Mom's 8 AM, sent from an Unsaid business number) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=unsaid_left_you_something
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0
# Optional, only for scripts/check_keys.py: the WhatsApp Business Account ID, to confirm the template is approved.
WHATSAPP_WABA_ID=

# --- App ---
# Shared secret for the student app and demo controls. Open the app once with ?key=<APP_KEY>.
# Leave empty locally. ALWAYS set it on a public deploy.
APP_KEY=
# The public https URL, used in the links sent to Mom and Sarah. Detected from requests if empty.
PUBLIC_BASE_URL=
# Where SQLite and uploaded media live.
DATA_DIR=./data
# Origins allowed to call the API from a browser (Gurneal's frontend). Comma-separated, or *.
CORS_ORIGINS=*

# --- Demo cast (phone numbers in international format, digits only or with +) ---
SEED_ME_NAME=Riley
SEED_ME_PHONE=
SEED_ME_TZ=America/Chicago
SEED_MOM_PHONE=
SEED_MOM_TZ=Asia/Kolkata
SEED_HOME_LANGUAGE=Hindi
SEED_DAD_PHONE=
SEED_SARAH_PHONE=
SEED_MICHAEL_INSTAGRAM=
# Older names, still read: SEED_JORDAN_PHONE (Sarah), SEED_PRIYA_INSTAGRAM (Michael).

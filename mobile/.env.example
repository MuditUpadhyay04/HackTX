# Public Expo env. These are inlined into the app when it is bundled.
# Do not put a real key in git. Set them in the shell, or in the EAS "preview" environment.
#
# Backend origin, no trailing slash. The phone must be able to reach this host.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Must match the backend APP_KEY. Leave empty only if that server does not require a key.
EXPO_PUBLIC_APP_KEY=

# Public Expo env. These are inlined into the JS bundle when it is bundled (expo start, eas build, eas update).
# Do not put a real key in git. For `npx expo start`, copy this to mobile/.env.local (git-ignored).
# For EAS builds/updates, set them in the EAS "preview" environment instead (see DEMO_RUNBOOK.md);
# `eas update --environment preview` ignores local .env files.
#
# Backend origin, no trailing slash. The phone must be able to reach this host.
#   Same Wi-Fi/hotspot as the laptop: http://<laptop LAN IP>:8000   (find it with: ipconfig getifaddr en0)
#   Different networks / EAS preview build: the https URL from cloudflared or ngrok
EXPO_PUBLIC_API_URL=http://localhost:8000
# Must equal the backend's APP_KEY (backend/.env or the shell that runs uvicorn).
# Sent as the X-App-Key header (and ?key= on media/WebSocket URLs).
# Leave empty only if the backend runs with APP_KEY unset (then it accepts every request).
EXPO_PUBLIC_APP_KEY=

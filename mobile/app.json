{
  "expo": {
    "name": "Un-Said",
    "slug": "unsaid",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.unsaid.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0D15",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0D15",
          "image": "./assets/brand/unsaid-app-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Un-Said looks through your photos with you, on this phone, to find the people you miss.",
          "savePhotosPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Un-Said listens only while you talk."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "scheme": "unsaid",
    "backgroundColor": "#0F0D15"
  }
}

# Caddy gets and renews the certificate for {$DOMAIN} by itself (Let's Encrypt, then ZeroSSL),
# as long as the name points at this server and ports 80 and 443 are open.
# reverse_proxy upgrades WebSockets (the live rant at /api/rants/live) with no extra config
# and sets X-Forwarded-Proto, so the links the backend sends Mom start with https.

{$DOMAIN} {
	reverse_proxy backend:8000 {
		# Keep a live rant connected for a while if Caddy's config is ever reloaded.
		stream_close_delay 5m
	}
}

# The phone mock (Branched-Frontend + the Un-Said web build at /unsaid), with its own certificate.
# PHONE_DOMAIN is phone.{$DOMAIN} (docker-compose.yml); sslip.io resolves it to this server too.
# Un-Said inside it calls {$DOMAIN} cross-origin (CORS_ORIGINS=* allows X-App-Key).
# Until update.sh has started the phone container this site answers 502; the backend is unaffected.
# (The default only keeps the file valid if PHONE_DOMAIN is ever missing; it is never served.)
{$PHONE_DOMAIN:phone.localhost} {
	encode zstd gzip
	reverse_proxy phone:3000
}

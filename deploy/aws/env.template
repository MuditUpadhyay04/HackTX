# Un-Said server settings. bootstrap.sh copies this to /srv/unsaid/.env (chmod 600).
# Keys live only in that file on the server. Never commit it, and never put keys in a launch script.
# Keep comments on their own lines: a "# note" after a value becomes part of the value.
# After editing: sudo /srv/unsaid/HackTX/deploy/aws/update.sh --no-pull

# ---------------------------------------------------------------- where it lives
# bootstrap.sh fills these when empty: DOMAIN from the public IP (e.g. 3-91-12-34.sslip.io),
# PUBLIC_BASE_URL as https://$DOMAIN. To use your own domain, point its A record here and set both.
DOMAIN=
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- the app
# Generated by bootstrap.sh when empty. The app and demo panel need it: ?key=<APP_KEY>,
# and EXPO_PUBLIC_APP_KEY in mobile/.env.local.
APP_KEY=
# Browser origins allowed to call the API. Comma-separated, or *.
CORS_ORIGINS=*

# ---------------------------------------------------------------- Meta Model API (Muse)
# Without MODEL_API_KEY the app runs on clearly labeled mock AI.
MODEL_API_KEY=
SPARK_MODEL=muse-spark-1.3
ASR_MODEL=muse-voice-transcribe-1.0
MODEL_API_BASE=https://api.meta.ai/v1
ASR_REALTIME_URL=wss://api.meta.ai/v1/asr/realtime

# ---------------------------------------------------------------- WhatsApp Cloud API (Mom's 8 AM)
# Without these, Mom's 8 AM falls back to "send it now?" through the share sheet.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=unsaid_left_you_something
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0
# Optional, only for scripts/check_keys.py (confirms the template is approved).
WHATSAPP_WABA_ID=

# ---------------------------------------------------------------- Gemini (optional, MLH track)
# Reads Muse's translation back into English on the letter preview.
# Off when empty. A failure never blocks Send.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------- demo cast (first boot only)
# Read once, when the database is empty. Later edits: the demo panel (/app/?demo=1) or PATCH /api/people.
# Phone numbers in international format, e.g. +919876543210.
SEED_ME_NAME=Riley
SEED_ME_PHONE=
SEED_ME_TZ=America/Chicago
SEED_MOM_PHONE=
SEED_MOM_TZ=Asia/Kolkata
SEED_HOME_LANGUAGE=Hindi
SEED_JORDAN_PHONE=
SEED_PRIYA_INSTAGRAM=
